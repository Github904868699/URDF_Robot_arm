<launch>
    <!-- 确保Gazebo可以找到ROS插件库（libgazebo_ros_api_plugin.so、libgazebo_ros_factory.so等） -->
    <env name="GAZEBO_PLUGIN_PATH" value="/opt/ros/noetic/lib:$(env GAZEBO_PLUGIN_PATH)" />

    <!-- 启动 dm_motor -->
    <include file="$(find dm_motor)/launch/dm_motor.launch" />

    <!-- 启动 003_moveit_config -->
    <include file="$(find 003_moveit_config)/launch/003_bringup_moveit.launch" />

    <!-- 启动 armcontrol_demo_pkg -->
    <include file="$(find armcontrol_demo_pkg)/launch/armcontrol_demo.launch" />
</launch>
